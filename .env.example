# Aplicação
APP_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=Moreira & Castro

# NFS-e: mock é o único padrão seguro para desenvolvimento
NFSE_PROVIDER=mock
NFSE_ENV=production_restricted
ENABLE_NFSE_PRODUCTION=false
ENABLE_NFSE_RESTRICTED_TRANSMISSION=false

# Supabase (use apenas a chave publicável no browser)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

# 32 bytes em base64. Gere separadamente por ambiente e nunca versionar.
CERTIFICATE_MASTER_KEY=
NFSE_CERT_PATH=
NFSE_CERT_PASSWORD=

# Segredo compartilhado da rota /api/internal/reconcile-pending — chamada só
# por um timer do servidor (nunca por um usuário logado). Gere um valor
# aleatório longo e nunca versione o real.
INTERNAL_RECONCILE_SECRET=

# Segredo compartilhado da rota /api/internal/certificados (tela "Subir certificado"
# do portal, server-to-server). Valor aleatório longo; nunca versionar o real.
CERTIFICATE_IMPORT_SECRET=

# Controle de certificados (outro projeto Supabase): onde o cadastro de A1 grava o vencimento.
CONTROLE_SUPABASE_URL=
CONTROLE_SUPABASE_SECRET_KEY=

# Pasta da fila de cópias da Relação de NFS-e para o SharePoint (lida pelo
# relacao_sharepoint.py no servidor). Vazio = não copia.
RELACAO_SHAREPOINT_FILA=

# Opcionais
RESEND_API_KEY=
SENTRY_DSN=

